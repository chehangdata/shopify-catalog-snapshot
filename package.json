{
  "name": "shopify-catalog-snapshot",
  "version": "1.1.0",
  "description": "Append-only daily snapshots of public Shopify storefront catalogues, plus a diff engine. Zero dependencies, TypeScript, Node 22+.",
  "type": "module",
  "bin": {
    "shopify-catalog-snapshot": "./collector.ts",
    "shopify-catalog-diff": "./diff.ts"
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "snapshot": "node collector.ts --domain allbirds.com --out out/day --pages 2",
    "diff": "node diff.ts --prev out/day1.jsonl --cur out/day2.jsonl --out out/delta",
    "test": "node verify.ts"
  },
  "license": "MIT"
}
